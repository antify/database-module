# Local example values for the playground. Copy to `.env`.
# Only point these at a throwaway local MongoDB (see docker-compose.yml).
# Never use a shared or production database: the playground runs migrations and fixtures against it.
NUXT_DB_CORE_URL=mongodb://localhost:27017/core?directConnection=true
NUXT_DB_TENANT_URL=mongodb://localhost:27017/?directConnection=true
